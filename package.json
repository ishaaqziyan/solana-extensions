{
  "name": "solana-extensions-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo scripts for the Token-2022 compliance token: mint creation, allowlist setup, transfers, clawback",
  "scripts": {
    "create-mint": "node --env-file-if-exists=.env --import tsx scripts/create-mint.ts",
    "show": "node --env-file-if-exists=.env --import tsx scripts/show-deployment.ts",
    "setup-allowlist": "node --env-file-if-exists=.env --import tsx scripts/setup-allowlist.ts",
    "demo-transfer": "node --env-file-if-exists=.env --import tsx scripts/demo-transfer.ts",
    "demo-clawback": "node --env-file-if-exists=.env --import tsx scripts/demo-clawback.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
