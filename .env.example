# Copy to .env and fill in. .env is gitignored; this file is the tracked template.
# Never put real keys in this file.

# Helius API key — used by the indexer (task #8) for webhooks, and optionally as
# a higher-rate-limit RPC endpoint for the demo scripts.
HELIUS_API_KEY=

# Optional. Defaults to https://api.devnet.solana.com when unset.
# For Helius: https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
RPC_URL=

# Optional. Defaults to devnet. Selects deployments/<cluster>.json.
CLUSTER=

# Optional. Defaults to ~/.config/solana/id.json.
# Path to the issuer keypair: mint authority, permanent delegate, allowlist authority.
ISSUER_KEYPAIR=

# Optional. 32-byte ElGamal public key, base64. Grants audit capability over
# confidential transfer amounts. Produced by the confidential flow (task #6);
# apply to an existing mint via UpdateMint.
AUDITOR_ELGAMAL_PUBKEY=

# Indexer (task #8) — Helius webhook receiver, see indexer/src/main.rs.

# Required by `npm run setup-webhook`. Shared secret Helius echoes back in the
# Authorization header on every delivery; the indexer rejects anything else.
# Any random string — not a Helius-issued value.
HELIUS_WEBHOOK_AUTH_TOKEN=

# Required by `npm run setup-webhook`. HTTPS URL Helius should POST to
# (the indexer's /webhook route). localhost isn't reachable from Helius, so
# this needs a tunnel (e.g. `ngrok http 8787`) for local development.
INDEXER_PUBLIC_URL=

# Optional. Port the indexer listens on. Defaults to 8787.
INDEXER_PORT=

# Optional. Where the indexer's event log is written. Defaults to
# indexer/events.jsonl.
INDEXER_EVENT_LOG=
